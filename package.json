{
  "name": "robrowser-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm prepare:runtime && vite --host 127.0.0.1",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build": "pnpm prepare:runtime && vite build",
    "test": "pnpm prepare:runtime && vitest run --exclude test/release-smoke.test.ts",
    "test:release": "pnpm build && vitest run test/release-smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "import:v2": "node scripts/import-v2-snapshot.mjs",
    "import:core": "node scripts/import-core-assets.mjs",
    "import:passive": "node scripts/import-passive-assets.mjs",
    "manifest:core": "node scripts/build-core-manifest.mjs",
    "audit:iwa": "node scripts/audit-iwa-dist.mjs",
    "bundle:iwa": "node scripts/bundle-iwa.mjs",
    "sign:iwa": "node scripts/sign-iwa.mjs",
    "release:metadata": "node scripts/build-release-metadata.mjs",
    "release:update-manifest": "node scripts/build-update-manifest.mjs",
    "release:verify": "node scripts/verify-release-inputs.mjs",
    "minify:release": "node scripts/minify-release-js.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "wbn": "0.0.9",
    "wbn-sign": "0.3.1"
  }
}
